{
  "manifest_version": 2,
  "name": "TabMover Background Bridge (Prototype)",
  "version": "0.3.0",
  "description": "Background browser adapter prototype for TabMover.",
  "permissions": ["tabs", "cookies", "storage", "nativeMessaging", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "bridge@tabmover.local", "strict_min_version": "115.0" } }
}
